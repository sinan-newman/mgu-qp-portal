      "marks": 10,
      "question": "Explain in detail communication hardware.",
      "solution_html": "<ul class=\"list-disc list-inside space-y-1.5 my-1 text-xs sm:text-sm text-slate-700 dark:text-slate-300\"><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">Communication Hardware</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">Communication hardware refers to physical devices used for data transmission.</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">Examples</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">• Modem – converts digital to analog signals</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">• Router – directs data between networks</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">• Switch – connects devices in a network</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">• Network cables – wired communication</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">• Wireless devices – Wi-Fi adapters</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">Functions</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">• Enables internet connectivity</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">• Data transfer between systems</li><li class=\"leading-relaxed text-xs sm:text-sm text-slate-700 dark:text-slate-300\">• Supports communication networks</li></ul>",
      "final_answer": "• Supports communication networks",
      "source_exam": "Second semester BA/BSc/BVocFYUGP April 2026",
      "has_official_scheme": true
    },
